  "mechanics": [
    {
      "topic": "Bank",
      "fact": "Underdocks und Night Harbor teilen sich die Bank (Gegenstand unten eingelagert, oben entnommen)",
      "verified": "ingame"
    },
    {
      "topic": "Bank",
      "fact": "Bank in der Underdocks: Citadel 3. Stock (Citadel Exchange), Banker Nethir, Rishopo, Vireya",
      "verified": "wiki"
    },
    {
      "topic": "Tracking",
      "fact": "Steigt durch Benutzung, kann dauerhaft laufen; Training beim Händler nicht nötig ('you cant train this')",
      "verified": "ingame"
    },
    {
      "topic": "NPC-Dialog",
      "fact": "NPCs reagieren nur auf ihre Stichwörter im /say-Kanal, nicht auf 'yes' (z. B. Father Fyod: 'I do')",
      "verified": "ingame"
    },
    {
      "topic": "Essen",
      "fact": "Charakter isst automatisch aus dem Inventar (Chat: 'You eat the Bread Rolls'); ohne Essen/Trinken sinkt Regeneration stark",
      "verified": "ingame + wiki"
    },
    {
      "topic": "Bard Measure",
      "fact": "3 Buff-Songs laufen automatisch weiter, ab Level 30 (Common Time) 4; schädliche/gezielte Songs verdrängen einen Song",
      "verified": "official"
    },
    {
      "topic": "Bard Instrumente",
      "fact": "Passendes Instrument +50% auf Stat-Buffs außer Haste, Regeneration, Mana-Regeneration, Absorb, Schadens-/DoT-Songs; nur das Instrument in der Nebenhand zählt",
      "verified": "official + ingame"
    },
    {
      "topic": "Haste",
      "fact": "Primär-Haste (Chords of Quickness, Shaman, Enchanter) stapelt nicht untereinander; Secondary Haste (Overture of Speed) stapelt; Haste wird von keinem Instrument verstärkt",
      "verified": "official + wiki"
    },
    {
      "topic": "Haste-Wahl",
      "fact": "Mit Shaman/Enchanter-Haste: Overture of Speed; ohne: Chords of Quickness",
      "verified": "derived"
    },
    {
      "topic": "Bard-Buffs auf Pets",
      "fact": "Gruppen-Songs wirken sichtbar auch auf Pets",
      "verified": "ingame"
    },
    {
      "topic": "Mez",
      "fact": "Schaden und DoTs brechen Mez; längerer Mez überschreibt kürzeren (seit 0.30)",
      "verified": "wiki"
    },
    {
      "topic": "Gruppen-XP",
      "fact": "Bis Level 15 max. 5 Level Abstand zum höchsten Mitglied, ab 16 mindestens 2/3 von dessen Level",
      "verified": "wiki"
    },
    {
      "topic": "Tod",
      "fact": "Leiche mit Items: ab Level 2 7 Tage, Level 1 2 Stunden; /consent Name zum Ziehen",
      "verified": "wiki"
    },
    {
      "topic": "Charaktererstellung",
      "fact": "Editor zeigt Current/Max pro Attribut; Max gilt nur für Bonuspunkte bei der Erstellung",
      "verified": "ingame"
    },
    {
      "topic": "Trait-Namen",
      "fact": "Im Editor teils anders als in Wikis (Bowman statt Deadeye, Medic statt Medicine)",
      "verified": "ingame"
    },
    {
      "topic": "STA",
      "fact": "STA erhöht max. Leben, HP-Regeneration im Sitzen, Schild-Blockchance und senkt Daze-Chance",
      "verified": "ingame (Tooltip)"
    },
    {
      "topic": "WIS",
      "fact": "WIS erhöht Mana (wenn höher als INT), Mana-Reg im Sitzen, Heilung und offensiven Zauberschaden nur bei CLR DRU PAL RNG SHM",
      "verified": "ingame (Tooltip)"
    },
    {
      "topic": "AC",
      "fact": "Armor Class = Rüstungswert gegen physischen Schaden; Formel nicht veröffentlicht",
      "verified": "wiki"
    },
    {
      "topic": "Traveler's March",
      "fact": "Nur draußen nutzbar",
      "verified": "ingame (Tooltip)"
    },
    {
      "topic": "Server-Population",
      "fact": "Snapshot: 473 gesamt; Ail'Vorith 18, Evershade Weald (Faelindral) 33, Night Harbor Ost 71, West 113, Underdocks 55",
      "verified": "ingame"
    },
    {
      "topic": "Reisen",
      "fact": "Faelindral -> Night Harbor nur per Boot über Keeper's Bight; NH-Boot fährt laut Wiki um 9 Uhr Spielzeit (/time)",
      "verified": "wiki"
    }
  ],
